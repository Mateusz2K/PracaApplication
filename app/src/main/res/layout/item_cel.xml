<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewNazwaCelu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadline6"
            tools:text="Wakacje na Malediwach" />

        <TextView
            android:id="@+id/textViewOpisCelu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            android:layout_marginTop="4dp"
            tools:text="Wyjazd na rajskie plaże, nurkowanie i relaks."
            android:visibility="gone"/> <!-- Możesz chcieć go pokazać, jeśli opis jest ważny -->

        <ProgressBar
            android:id="@+id/progressBarCel"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            tools:progress="60" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/textViewAktualnaKwotaCelu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBody1"
                tools:text="12000 zł" />

            <TextView
                android:id="@+id/textViewKwotaDocelowaCelu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textStyle="bold"
                tools:text="/ 20000 zł" />
        </LinearLayout>

        <TextView
            android:id="@+id/textViewDataZakonczeniaCelu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceCaption"
            android:layout_marginTop="4dp"
            tools:text="Do: 31.12.2025" />

        <!-- NOWY TextView dla statusu -->
        <TextView
            android:id="@+id/textViewStatusCelu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textStyle="italic"
            android:layout_marginTop="4dp"
            tools:text="Status: Aktywny"
            android:visibility="gone"/> <!-- Ustaw na visible, jeśli chcesz go zawsze pokazywać -->


        <!-- Przyciski akcji -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="end">

            <Button
                android:id="@+id/buttonDodajSrodkiDoCelu"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dodaj Środki"
                android:layout_marginEnd="8dp"/>

            <ImageButton
                android:id="@+id/buttonEdytujCel"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edytuj cel"
                android:src="@drawable/ic_edit" />

            <ImageButton
                android:id="@+id/buttonUsunCel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Usuń cel"
                android:src="@drawable/ic_delete" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
