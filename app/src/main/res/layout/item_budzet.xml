<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="4dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/budget_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toStartOf="@+id/buttonBudzetOptions"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/nazwaBudzetu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nazwa Budżetu"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/dataBudzetu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Od: 01.01.2024 Do: 31.01.2024"
                android:textAppearance="?attr/textAppearanceBody2" />

            <TextView
                android:id="@+id/kwotaBudzetu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Przewidywany dochód: 5000.00 zł"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/saldoBudzetu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Saldo: +500.00 zł"
                android:textStyle="bold"
                android:textAppearance="?attr/textAppearanceBody1" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/buttonBudzetOptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Opcje budżetu"
            android:src="@drawable/ic_more_vert" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>